2. C Code
#include <stdio.h>

int main() {
    unsigned int a, b;

    printf("Enter first number: ");
    scanf("%u", &a);

    printf("Enter second number: ");
    scanf("%u", &b);

    if (a > 255 || b > 15) {
        printf("Invalid input. Enter A between 0-255 and B between 0-15.\n");
        return 1;
    }

    // Extract lower four bits
    unsigned int extracted = a & 15;

    // Combine extracted bits with second number
    unsigned int combined = extracted | b;

    printf("Original Number: %u\n", a);
    printf("Extracted Lower 4 Bits: %u\n", extracted);
    printf("Combined Result: %u\n", combined);

    return 0;
}


